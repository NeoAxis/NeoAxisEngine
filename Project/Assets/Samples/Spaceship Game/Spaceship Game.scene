					.component NeoAxis.FlowGraphNode
					{
						Name = Node Shader 1
						Position = -14 -10
						ControlledObject
						{
							GetByReference = "this:$Shader"
						}
						.component NeoAxis.ShaderScript
						{
							Name = Shader
							Code = "vec2 hash22(vec2 p)\r\n{\r\n    vec3 p3 = fract(vec3(p.xyx) * vec3(443.897, 441.423, 437.195));\r\n    p3 += dot(p3, p3.yzx + 19.19);\r\n    return fract((p3.xx + p3.yz) * p3.zy);\r\n}\r\n\r\nvec4 hash42(vec2 p)\r\n{\r\n    vec4 p4 = fract(vec4(p.xyxy) * vec4(.1031, .1030, .0973, .1099));\r\n    p4 += dot(p4, p4.wzxy + 19.19);\r\n    return fract((p4.xxyz + p4.yzzw) * p4.zywx) - 0.5;\r\n}\r\n\r\nvec3 StarFieldLayer(vec2 p, float du, float count, float brightness, float size)\r\n{\r\n    vec3 cold = vec3(255.0, 244.0, 189.0) / 255.0;\r\n    vec3 hot = vec3(181.0, 236.0, 255.0) / 255.0;\r\n\r\n    vec2 pi;\r\n    du *= count;\r\n    p *= count;\r\n    pi = floor(p);\r\n    p = fract(p) - 0.5;\r\n  \r\n    vec4 h = hash42(pi);\r\n\r\n    float dist = length(p + 0.9 * h.xy) - size * du;\r\n    float s = brightness * (0.7 + 0.6 * h.z) * smoothstep(0.8 * du, -0.2 * du, dist);\r\n\r\n    return s * mix(mix(vec3_splat(1.0), cold, min(1.0, -2.0 * h.w)), hot, max(0.0, 2.0 * h.w));\r\n}\r\n\r\nvec3 StarField(vec2 p, float du)\r\n{\r\n    vec3 c = vec3_splat(0.0);\r\n    \r\n    c += StarFieldLayer(p, du, 25.0, 0.15, 0.5);\r\n//    c += StarFieldLayer(p, du, 15.0, 0.22, 0.5);\r\n//    c += StarFieldLayer(p, du, 10.0, 0.40, 0.5);\r\n    c += StarFieldLayer(p, du, 5.0, 0.85, 0.5);\r\n    c += StarFieldLayer(p, du, 3.0, 0.90, 0.9);\r\n\r\n    c *= 1.2;\r\n    \r\n    float f = 1.0 / sqrt(60.0 * du);\r\n    return f * min(c, 1.0);\r\n}\r\n\r\npublic vec4 Method(vec2 texCoord)\r\n{\r\n    vec2 iResolution = u_viewportSize;\r\n    float iTime = u_engineTime;\r\n\r\n    float du = 1.0 / iResolution.y;\r\n    vec2 uv = du * (texCoord * iResolution - 0.5 * iResolution.xy) + vec2(0.0, - iTime / 30.0);\r\n    \r\n    return vec4(StarField(uv, du), 1.0);\r\n}"
