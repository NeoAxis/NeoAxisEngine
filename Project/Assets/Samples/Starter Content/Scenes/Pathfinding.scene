			Name = C# Script
			NetworkMode = False
			Code = "public void PathfindingGeometry_UpdateEvent(NeoAxis.Component sender, float delta)\r\n{\r\n\tvar obj = (ObjectInSpace)sender;\r\n\tvar sourceTransform = obj.Transform.Value;\r\n\tvar rotation = Quaternion.FromRotateByZ( EngineApp.EngineTime * 0.2 );\r\n\tobj.Transform = new Transform( sourceTransform.Position, rotation, sourceTransform.Scale ); \r\n}\r\n"
			__parameter_Delta = 0
			Exit
			{
			}
			.component NeoAxis.EventHandlerComponent
			{
				Name = Event Handler UpdateEvent
